{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/job-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/job-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/job-guard.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/job-guard.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f \"$HOME/.claude/skills/job/scripts/job-board.mjs\" && node \"$HOME/.claude/skills/job/scripts/job-board.mjs\" hook || true",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f \"$HOME/.claude/skills/job/scripts/job-board.mjs\" && node \"$HOME/.claude/skills/job/scripts/job-board.mjs\" hook || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
